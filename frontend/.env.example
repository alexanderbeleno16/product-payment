# Public API origin for separate-origin deployment. Omit for Vite's local proxy.
VITE_API_BASE_URL=https://api.example.com
# Public HTTPS API origin for browser-side encrypted card tokenization.
# Configure this locally and in the deployment environment; never put a private key here.
VITE_PAYMENT_API_BASE_URL=https://sandbox.example.invalid/v1
VITE_PAYMENT_SANDBOX_HOST=sandbox.example.invalid
